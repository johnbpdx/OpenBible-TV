' *****************************************************************************
' * OpenBible-TV
' * Main entry point for the Roku channel
' *****************************************************************************
function Main(args as object) as void
    print "🚀 OpenBible-TV starting..."

    ' Create the screen
    screen = CreateObject("roSGScreen")
    port = CreateObject("roMessagePort")
    screen.setMessagePort(port)

    ' Show the Home Scene
    scene = screen.CreateScene("HomeScene")
    screen.show()

    ' Main event loop
    while true
        msg = wait(0, port)
        msgType = type(msg)

        if msgType = "roSGScreenEvent"
            if msg.isScreenClosed()
                print "Screen closed - exiting"
                return
            end if
        end if
    end while
end function
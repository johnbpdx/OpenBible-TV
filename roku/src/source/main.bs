function Main(args as object) as void
    screen = CreateObject("roSGScreen")
    port = CreateObject("roMessagePort")
    screen.setMessagePort(port)

    ' Memory monitoring — required for Roku certification
    appMemoryMonitor = CreateObject("roAppMemoryMonitor")
    appMemoryMonitor.setMessagePort(port)
    appMemoryMonitor.EnableLowGeneralMemoryLevel(20)

    ' Create scene
    scene = screen.CreateScene("HomeScene")
    screen.show()
    scene.setFocus(true)

    print "=== OpenBible-TV Launched ==="

    while true
        msg = wait(0, port)
        if type(msg) = "roSGScreenEvent"
            if msg.isScreenClosed() then return
        else if type(msg) = "roAppMemoryNotificationEvent"
            if msg.isLowGeneralMemoryLevel()
                print "=== Low Memory Warning ==="
            end if
        end if
    end while
end function
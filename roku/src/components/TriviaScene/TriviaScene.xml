<?xml version="1.0" encoding="utf-8" ?>
<component name="TriviaScene" extends="Group">

    <interface>
        <field id="closeScene" type="boolean" alwaysNotify="true" />
        <field id="bookName" type="string" />
        <field id="bookAbbrev" type="string" />
        <field id="chapterNumber" type="integer" onChange="onChapterSet" />
    </interface>

    <children>

        <!-- Background -->
        <Rectangle
            width="1920"
            height="1080"
            color="#0f172a" />

        <!-- Accent bar -->
        <Rectangle
            width="1920"
            height="6"
            color="#3b82f6" />

        <!-- Header: Book + Chapter -->
        <Label
            id="headerLabel"
            translation="[60, 20]"
            width="1400"
            height="50"
            font="font:MediumBoldSystemFont"
            color="#3b82f6"
            text="" />

        <!-- Progress: "Question N of M" -->
        <Label
            id="progressLabel"
            translation="[1300, 20]"
            width="560"
            height="50"
            font="font:SmallBoldSystemFont"
            color="#64748b"
            horizAlign="right"
            text="" />

        <!-- Divider below header -->
        <Rectangle
            translation="[60, 80]"
            width="1800"
            height="2"
            color="#1e293b" />

        <!-- Question text — large, centered vertically in question area -->
        <Label
            id="questionText"
            translation="[60, 110]"
            width="1800"
            height="300"
            font="font:LargeBoldSystemFont"
            color="#f1f5f9"
            wrap="true"
            text="" />

        <!-- Answer section (hidden until revealed) -->
        <Group id="answerGroup">

            <!-- Divider above answer -->
            <Rectangle
                translation="[60, 425]"
                width="1800"
                height="2"
                color="#1e293b" />

            <!-- Answer section header -->
            <Label
                id="answerHeader"
                translation="[60, 440]"
                width="900"
                height="36"
                font="font:SmallBoldSystemFont"
                color="#64748b"
                text="CHAPTER TEXT" />

            <!-- Scroll hint -->
            <Label
                id="answerScrollHint"
                translation="[1400, 444]"
                width="460"
                height="28"
                font="font:SmallSystemFont"
                color="#475569"
                horizAlign="right"
                text="" />

            <!-- Clip window for scrollable chapter text -->
            <Group
                id="answerClip"
                translation="[60, 490]"
                clippingRect="[0, 0, 1800, 490]">
                <Label
                    id="answerText"
                    translation="[0, 0]"
                    width="1800"
                    height="4000"
                    font="font:SmallSystemFont"
                    color="#94a3b8"
                    wrap="true"
                    text="" />
            </Group>

        </Group>

        <!-- Complete screen (shown after all questions answered) -->
        <Group id="completeGroup">

            <Label
                id="completeLabel"
                translation="[60, 340]"
                width="1800"
                height="120"
                font="font:LargeBoldSystemFont"
                color="#f1f5f9"
                horizAlign="center"
                vertAlign="center"
                text="Quiz Complete!" />

            <Label
                id="completeSubLabel"
                translation="[60, 480]"
                width="1800"
                height="60"
                font="font:MediumSystemFont"
                color="#94a3b8"
                horizAlign="center"
                text="" />

        </Group>

        <!-- Hint bar -->
        <Rectangle
            translation="[0, 1040]"
            width="1920"
            height="40"
            color="#111827" />

        <Label
            id="hintBar"
            translation="[0, 1040]"
            width="1920"
            height="40"
            horizAlign="center"
            vertAlign="center"
            font="font:SmallSystemFont"
            color="#64748b"
            text="" />

    </children>

</component>

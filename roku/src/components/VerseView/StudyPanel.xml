<?xml version="1.0" encoding="utf-8" ?>
<component name="StudyPanel" extends="Group">

    <interface>
        <field id="closePanel" type="boolean" alwaysNotify="true" />
        <field id="bookName" type="string" />
        <field id="bookAbbrev" type="string" value="" />
        <field id="chapterNumber" type="integer" />
        <field id="verseNumber" type="string" />
        <field id="verseText" type="string" onChange="onVerseSet" />
    </interface>

    <children>

        <!-- Dim overlay behind the panel -->
        <Rectangle
            id="dimOverlay"
            width="1920"
            height="1080"
            color="#000000"
            opacity="0.65" />

        <!-- Panel card -->
        <Rectangle
            id="panelCard"
            translation="[160, 80]"
            width="1600"
            height="920"
            color="#0f172a" />

        <!-- Accent top bar -->
        <Rectangle
            id="panelAccent"
            translation="[160, 80]"
            width="1600"
            height="6"
            color="#3b82f6" />

        <!-- Reference label e.g. "John 3:16" -->
        <Label
            id="referenceLabel"
            translation="[200, 110]"
            width="1520"
            height="60"
            font="font:MediumBoldSystemFont"
            color="#3b82f6"
            text="" />

        <!-- Verse text — large and readable -->
        <Label
            id="verseLabel"
            translation="[200, 180]"
            width="1520"
            height="220"
            font="font:LargeSystemFont"
            color="#f1f5f9"
            wrap="true"
            text="" />

        <!-- Divider -->
        <Rectangle
            id="divider"
            translation="[200, 415]"
            width="1520"
            height="2"
            color="#1e293b" />

        <!-- Commentary section header -->
        <Label
            id="commentaryHeader"
            translation="[200, 430]"
            width="1520"
            height="40"
            font="font:SmallBoldSystemFont"
            color="#64748b"
            text="COMMENTARY  (Matthew Henry)" />

        <!-- Commentary text -->
        <Label
            id="commentaryText"
            translation="[200, 480]"
            width="1520"
            height="460"
            font="font:SmallSystemFont"
            color="#94a3b8"
            wrap="true"
            text="" />

        <!-- Hint -->
        <Label
            id="panelHint"
            translation="[200, 960]"
            width="1520"
            height="30"
            font="font:SmallSystemFont"
            color="#334155"
            horizAlign="center"
            text="⟵ Back to chapter" />

    </children>

</component>

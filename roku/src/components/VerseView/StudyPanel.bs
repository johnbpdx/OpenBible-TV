' *****************************************************************************
' * StudyPanel.bs
' * Verse study overlay — shows selected verse + Matthew Henry commentary
' *****************************************************************************

sub init()
    print "StudyPanel initialized"
    m.referenceLabel = m.top.findNode("referenceLabel")
    m.verseLabel = m.top.findNode("verseLabel")
    m.commentaryText = m.top.findNode("commentaryText")
end sub

sub onVerseSet()
    book = m.top.bookName
    chapter = m.top.chapterNumber
    verse = m.top.verseNumber
    text = m.top.verseText

    m.referenceLabel.text = book + " " + stri(chapter).trim() + ":" + verse
    m.verseLabel.text = chr(8220) + text + chr(8221)

    ' TODO: load Matthew Henry commentary from bundled data or future API
    m.commentaryText.text = "Commentary for " + book + " " + stri(chapter).trim() + ":" + verse + " will appear here. Matthew Henry's commentary data will be bundled in a future update."
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "back"
        m.top.closePanel = true
        return true
    end if

    return false
end function

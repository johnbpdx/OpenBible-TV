' *****************************************************************************
' * StudyPanel.bs
' * Verse study overlay — shows selected verse + Matthew Henry commentary
' *****************************************************************************

sub init()
    print "StudyPanel initialized"
    m.referenceLabel = m.top.findNode("referenceLabel")
    m.verseLabel = m.top.findNode("verseLabel")
    m.commentaryText = m.top.findNode("commentaryText")
end sub

sub onVerseSet()
    book = m.top.bookName
    abbrev = m.top.bookAbbrev
    chapter = m.top.chapterNumber
    verse = m.top.verseNumber
    text = m.top.verseText

    m.referenceLabel.text = book + " " + stri(chapter).trim() + ":" + verse
    m.verseLabel.text = chr(8220) + text + chr(8221)

    ' Load Matthew Henry Concise Commentary from bundled JSON
    commentary = ""
    if abbrev <> "" and abbrev <> invalid
        filePath = "pkg:/data/commentary/" + abbrev + ".json"
        jsonStr = ReadAsciiFile(filePath)
        if jsonStr <> ""
            data = ParseJson(jsonStr)
            chapterStr = stri(chapter).trim()
            if data <> invalid and data.DoesExist(chapterStr)
                commentary = data[chapterStr]
            end if
        end if
    end if

    if commentary = "" or commentary = invalid
        m.commentaryText.text = "Commentary not available for this passage."
    else
        m.commentaryText.text = commentary
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "back"
        m.top.closePanel = true
        return true
    end if

    return false
end function

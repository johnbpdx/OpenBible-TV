<?xml version="1.0" encoding="utf-8" ?>
<component name="VerseView" extends="Group">

    <interface>
        <field id="closeScene" type="boolean" alwaysNotify="true" />
        <field id="bookName" type="string" />
        <field id="bookAbbrev" type="string" />
        <field id="chapterNumber" type="integer" onChange="onChapterSet" />
    </interface>

    <children>

        <!-- Background -->
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="#0f172a" />

        <!-- Header -->
        <Rectangle
            id="header"
            width="1920"
            height="75"
            color="#1e2937" />

        <Label
            id="chapterTitle"
            text=""
            font="font:MediumBoldSystemFont"
            horizAlign="center"
            vertAlign="center"
            width="1920"
            height="75"
            color="#e2e8f0" />

        <!-- Scrollable verse list: 9 visible rows of 100px each -->
        <MarkupList
            id="verseList"
            translation="[110, 85]"
            itemComponentName="VerseItem"
            numRows="9"
            itemSize="[1700, 100]"
            itemSpacing="[0, 5]"
            focusable="true"
            drawFocusFeedback="false" />

        <!-- Hint bar at bottom -->
        <Rectangle
            id="hintBar"
            translation="[0, 1040]"
            width="1920"
            height="40"
            color="#111827" />

        <Label
            id="hintLabel"
            translation="[0, 1040]"
            width="1920"
            height="40"
            horizAlign="center"
            vertAlign="center"
            font="font:SmallSystemFont"
            color="#64748b"
            text="&lt; Prev Ch   Up/Dn Scroll   OK Study Verse   Next Ch &gt;   Back" />

    </children>

</component>

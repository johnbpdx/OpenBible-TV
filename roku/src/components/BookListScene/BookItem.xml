<?xml version="1.0" encoding="utf-8" ?>
<component name="BookItem" extends="Group">

    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusChange" />
    </interface>

    <children>

        <Rectangle
            id="itemBackground"
            width="270"
            height="80"
            color="#1e293b" />

        <Label
            id="bookLabel"
            width="250"
            height="80"
            horizAlign="center"
            vertAlign="center"
            font="font:MediumSystemFont"
            color="#e2e8f0"
            translation="[10, 0]" />

    </children>

</component>
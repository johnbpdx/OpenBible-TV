' *****************************************************************************
' * BookListScene.bs
' * Book selection screen - single scrollable grid of all 66 books
' *****************************************************************************

sub init()
    print "BookListScene initialized"
    m.bookGrid = m.top.findNode("bookGrid")
    m.testamentLabel = m.top.findNode("testamentLabel")

    populateBookGrid()

    m.bookGrid.observeField("itemFocused", "onItemFocused")
    m.bookGrid.setFocus(true)
end sub

sub onGiveFocus()
    if m.bookGrid <> invalid
        m.bookGrid.setFocus(true)
    end if
end sub

sub populateBookGrid()
    allBooks = [
        {title: "Genesis", testament: "OT"},
        {title: "Exodus", testament: "OT"},
        {title: "Leviticus", testament: "OT"},
        {title: "Numbers", testament: "OT"},
        {title: "Deuteronomy", testament: "OT"},
        {title: "Joshua", testament: "OT"},
        {title: "Judges", testament: "OT"},
        {title: "Ruth", testament: "OT"},
        {title: "1 Samuel", testament: "OT"},
        {title: "2 Samuel", testament: "OT"},
        {title: "1 Kings", testament: "OT"},
        {title: "2 Kings", testament: "OT"},
        {title: "1 Chronicles", testament: "OT"},
        {title: "2 Chronicles", testament: "OT"},
        {title: "Ezra", testament: "OT"},
        {title: "Nehemiah", testament: "OT"},
        {title: "Esther", testament: "OT"},
        {title: "Job", testament: "OT"},
        {title: "Psalms", testament: "OT"},
        {title: "Proverbs", testament: "OT"},
        {title: "Ecclesiastes", testament: "OT"},
        {title: "Song of Solomon", testament: "OT"},
        {title: "Isaiah", testament: "OT"},
        {title: "Jeremiah", testament: "OT"},
        {title: "Lamentations", testament: "OT"},
        {title: "Ezekiel", testament: "OT"},
        {title: "Daniel", testament: "OT"},
        {title: "Hosea", testament: "OT"},
        {title: "Joel", testament: "OT"},
        {title: "Amos", testament: "OT"},
        {title: "Obadiah", testament: "OT"},
        {title: "Jonah", testament: "OT"},
        {title: "Micah", testament: "OT"},
        {title: "Nahum", testament: "OT"},
        {title: "Habakkuk", testament: "OT"},
        {title: "Zephaniah", testament: "OT"},
        {title: "Haggai", testament: "OT"},
        {title: "Zechariah", testament: "OT"},
        {title: "Malachi", testament: "OT"},
        {title: "Matthew", testament: "NT"},
        {title: "Mark", testament: "NT"},
        {title: "Luke", testament: "NT"},
        {title: "John", testament: "NT"},
        {title: "Acts", testament: "NT"},
        {title: "Romans", testament: "NT"},
        {title: "1 Corinthians", testament: "NT"},
        {title: "2 Corinthians", testament: "NT"},
        {title: "Galatians", testament: "NT"},
        {title: "Ephesians", testament: "NT"},
        {title: "Philippians", testament: "NT"},
        {title: "Colossians", testament: "NT"},
        {title: "1 Thessalonians", testament: "NT"},
        {title: "2 Thessalonians", testament: "NT"},
        {title: "1 Timothy", testament: "NT"},
        {title: "2 Timothy", testament: "NT"},
        {title: "Titus", testament: "NT"},
        {title: "Philemon", testament: "NT"},
        {title: "Hebrews", testament: "NT"},
        {title: "James", testament: "NT"},
        {title: "1 Peter", testament: "NT"},
        {title: "2 Peter", testament: "NT"},
        {title: "1 John", testament: "NT"},
        {title: "2 John", testament: "NT"},
        {title: "3 John", testament: "NT"},
        {title: "Jude", testament: "NT"},
        {title: "Revelation", testament: "NT"}
    ]

    content = CreateObject("roSGNode", "ContentNode")
    for each book in allBooks
        node = content.createChild("ContentNode")
        node.title = book.title
        node.addField("testament", "string", false)
        node.testament = book.testament
    end for
    m.bookGrid.content = content
end sub

sub onItemFocused()
    index = m.bookGrid.itemFocused
    child = m.bookGrid.content.getChild(index)
    if child = invalid then return

    if child.testament = "NT"
        m.testamentLabel.text = "NEW TESTAMENT"
        m.testamentLabel.color = "#60a5fa"
    else
        m.testamentLabel.text = "OLD TESTAMENT"
        m.testamentLabel.color = "#94a3b8"
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false

    if key = "back"
        m.top.closeScene = true
        return true
    else if key = "OK"
        index = m.bookGrid.itemFocused
        child = m.bookGrid.content.getChild(index)
        if child <> invalid
            print "Selected book: " + child.title
            m.top.selectedBookAbbrev = titleToAbbrev(child.title)
            m.top.selectedBook = child.title
        end if
        return true
    end if

    return false
end function

function titleToAbbrev(title as string) as string
    if title = "Genesis"         then return "gn"
    if title = "Exodus"          then return "ex"
    if title = "Leviticus"       then return "lv"
    if title = "Numbers"         then return "nm"
    if title = "Deuteronomy"     then return "dt"
    if title = "Joshua"          then return "js"
    if title = "Judges"          then return "jdg"
    if title = "Ruth"            then return "rt"
    if title = "1 Samuel"        then return "1sm"
    if title = "2 Samuel"        then return "2sm"
    if title = "1 Kings"         then return "1kgs"
    if title = "2 Kings"         then return "2kgs"
    if title = "1 Chronicles"    then return "1ch"
    if title = "2 Chronicles"    then return "2ch"
    if title = "Ezra"            then return "ezr"
    if title = "Nehemiah"        then return "ne"
    if title = "Esther"          then return "est"
    if title = "Job"             then return "jb"
    if title = "Psalms"          then return "ps"
    if title = "Proverbs"        then return "prv"
    if title = "Ecclesiastes"    then return "ec"
    if title = "Song of Solomon" then return "sg"
    if title = "Isaiah"          then return "is"
    if title = "Jeremiah"        then return "jr"
    if title = "Lamentations"    then return "lm"
    if title = "Ezekiel"         then return "ez"
    if title = "Daniel"          then return "dn"
    if title = "Hosea"           then return "hs"
    if title = "Joel"            then return "jl"
    if title = "Amos"            then return "am"
    if title = "Obadiah"         then return "ob"
    if title = "Jonah"           then return "jon"
    if title = "Micah"           then return "mc"
    if title = "Nahum"           then return "na"
    if title = "Habakkuk"        then return "hbk"
    if title = "Zephaniah"       then return "zp"
    if title = "Haggai"          then return "hg"
    if title = "Zechariah"       then return "zc"
    if title = "Malachi"         then return "ml"
    if title = "Matthew"         then return "mt"
    if title = "Mark"            then return "mk"
    if title = "Luke"            then return "lk"
    if title = "John"            then return "jn"
    if title = "Acts"            then return "act"
    if title = "Romans"          then return "rm"
    if title = "1 Corinthians"   then return "1co"
    if title = "2 Corinthians"   then return "2co"
    if title = "Galatians"       then return "gl"
    if title = "Ephesians"       then return "eph"
    if title = "Philippians"     then return "ph"
    if title = "Colossians"      then return "cl"
    if title = "1 Thessalonians" then return "1ts"
    if title = "2 Thessalonians" then return "2ts"
    if title = "1 Timothy"       then return "1tm"
    if title = "2 Timothy"       then return "2tm"
    if title = "Titus"           then return "tt"
    if title = "Philemon"        then return "phm"
    if title = "Hebrews"         then return "hb"
    if title = "James"           then return "jms"
    if title = "1 Peter"         then return "1pt"
    if title = "2 Peter"         then return "2pt"
    if title = "1 John"          then return "1jn"
    if title = "2 John"          then return "2jn"
    if title = "3 John"          then return "3jn"
    if title = "Jude"            then return "jd"
    if title = "Revelation"      then return "rv"
    return ""
end function
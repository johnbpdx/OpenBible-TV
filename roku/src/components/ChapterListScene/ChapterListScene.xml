<?xml version="1.0" encoding="utf-8" ?>
<component name="ChapterListScene" extends="Group">

    <interface>
        <field id="selectedChapter" type="integer" alwaysNotify="true" />
        <field id="closeScene" type="boolean" alwaysNotify="true" />
        <field id="bookName" type="string" />
        <field id="bookAbbrev" type="string" onChange="onBookSet" />
    </interface>

    <children>

        <!-- Background -->
        <Rectangle
            id="background"
            width="1920"
            height="1080"
            color="#0f172a" />

        <!-- Header -->
        <Rectangle
            id="header"
            width="1920"
            height="110"
            color="#1e2937" />

        <Label
            id="bookTitle"
            text=""
            font="font:LargeBoldSystemFont"
            horizAlign="center"
            vertAlign="center"
            width="1920"
            height="110"
            color="#e2e8f0" />

        <Label
            id="subtitle"
            text="Select a Chapter"
            font="font:SmallBoldSystemFont"
            horizAlign="left"
            vertAlign="center"
            translation="[120, 120]"
            width="500"
            height="40"
            color="#94a3b8" />

        <!-- Grid of chapter numbers: 10 columns, 8 visible rows -->
        <MarkupGrid
            id="chapterGrid"
            translation="[80, 175]"
            itemComponentName="ChapterItem"
            numColumns="10"
            numRows="8"
            itemSize="[160, 80]"
            itemSpacing="[10, 10]"
            focusable="true"
            drawFocusFeedback="false" />

    </children>

</component>
